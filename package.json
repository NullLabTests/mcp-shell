{
  "name": "mcp-shell",
  "version": "1.0.0",
  "description": "A universal MCP (Model Context Protocol) client — connect to any MCP server via stdio, SSE, Streamable HTTP, or WebSocket",
  "type": "module",
  "bin": {
    "mcp-shell": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "client",
    "cli",
    "ai",
    "llm",
    "tool-calling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NullLabTests/mcp-shell.git"
  },
  "bugs": {
    "url": "https://github.com/NullLabTests/mcp-shell/issues"
  },
  "homepage": "https://github.com/NullLabTests/mcp-shell#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
